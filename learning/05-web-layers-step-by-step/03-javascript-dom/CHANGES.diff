--- previous/index.html
+++ current/index.html
@@ -14,8 +14,10 @@
         <span class="book-topic">JavaScript</span>
         <h2>جاوااسکریپت کاربردی</h2>
         <p class="book-price">۲۰۰٬۰۰۰ تومان</p>
-        <button id="choose-button" class="choose-button" type="button">انتخاب کتاب</button>
+        <button id="choose-button" class="choose-button" type="button" aria-pressed="false">انتخاب کتاب</button>
       </article>
+      <p id="selection-summary" role="status">هنوز کتابی انتخاب نکرده‌ای</p>
     </main>
