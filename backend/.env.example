# Local development
ENVIRONMENT=local
DEPLOYMENT_TIER=staging
RELEASE_SHA=local
DEBUG=false
PROJECT_NAME=ChinVerse API

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chinverse_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800

SECRET_KEY=replace-this-with-a-generated-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=chinverse_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
AUTH_DEBUG_TOKENS=false
REQUIRE_VERIFIED_LOGIN=false
AUTH_DELIVERY_WEBHOOK_URL=
AUTH_DELIVERY_WEBHOOK_SECRET=
AUTH_PUBLIC_APP_URL=http://localhost:3000
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
MFA_ENCRYPTION_KEY=
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100

RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=database
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1
TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_CHALLENGE_REQUESTS=10
RATE_LIMIT_AUTH_CHALLENGE_WINDOW_SECONDS=60
RATE_LIMIT_ACCOUNT_LOGIN_REQUESTS=20
RATE_LIMIT_ACCOUNT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_WRITE_REQUESTS=60
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=300
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=

MAX_IMAGE_UPLOAD_SIZE_BYTES=5242880
MAX_IMAGE_PIXEL_COUNT=40000000
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,jfif,png,webp,heic,heif,gif,avif,bmp,tif,tiff
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/pjpeg,image/png,image/webp,image/heic,image/heif,image/heic-sequence,image/heif-sequence,image/gif,image/avif,image/bmp,image/x-ms-bmp,image/tiff,application/octet-stream
MAX_VIDEO_UPLOAD_SIZE_BYTES=524288000
MAX_DICTIONARY_IMPORT_SIZE_BYTES=10485760
MAX_API_REQUEST_SIZE_BYTES=2097152
MULTIPART_OVERHEAD_ALLOWANCE_BYTES=1048576
ALLOWED_VIDEO_EXTENSIONS=mp4,webm,mov,m4v
ALLOWED_VIDEO_CONTENT_TYPES=video/mp4,video/webm,video/quicktime,video/x-m4v
FILE_STORAGE_MODE=local
MOUNTED_STORAGE_ROOT=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_BUCKET_NAME=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ADDRESSING_STYLE=path

BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000
BACKEND_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|0\.0\.0\.0|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3})(:\d+)?$
ALLOWED_HOSTS=*

ENABLE_API_DOCS=true
SECURE_HEADERS_ENABLED=true
HSTS_ENABLED=false

FEATURE_SUBSCRIPTIONS_ENABLED=false
FEATURE_REFERRALS_ENABLED=false
FEATURE_POINTS_ENABLED=false

# Production example
# ENVIRONMENT=production
# DEPLOYMENT_TIER=production
# DATABASE_URL=postgresql://app_user:strong_password@db-host:5432/chinverse_db
# SECRET_KEY=generate-with-python-secrets-token-urlsafe
# REFRESH_COOKIE_NAME=__Host-chinverse_refresh
# REFRESH_COOKIE_SECURE=true
# REQUIRE_VERIFIED_LOGIN=true
# AUTH_DELIVERY_WEBHOOK_URL=https://your-delivery-adapter.example/challenges
# AUTH_DELIVERY_WEBHOOK_SECRET=set-in-secret-manager
# AUTH_PUBLIC_APP_URL=https://your-frontend-domain.com
# MFA_ENCRYPTION_KEY=set-in-secret-manager
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_BACKEND=database
# TRUST_PROXY_HEADERS=true
# TRUSTED_PROXY_COUNT=1
# TRUSTED_PROXY_NETWORKS=set-to-the-CIDRs-of-your-edge-proxy
# TURNSTILE_ENABLED=true
# TURNSTILE_SECRET_KEY=set-in-secret-manager
# TURNSTILE_EXPECTED_HOSTNAMES=your-frontend-domain.com
# BACKEND_CORS_ORIGINS=https://your-frontend-domain.com
# BACKEND_CORS_ORIGIN_REGEX=
# ALLOWED_HOSTS=your-api-domain.com
# ENABLE_API_DOCS=false
# SECURE_HEADERS_ENABLED=true
# HSTS_ENABLED=true
# FILE_STORAGE_MODE=s3
# For a persistent volume in a staging Space, use:
# FILE_STORAGE_MODE=mounted
# MOUNTED_STORAGE_ROOT=/data
# OBJECT_STORAGE_ENDPOINT_URL=https://s3.hf.co/MoAmin9
# OBJECT_STORAGE_BUCKET_NAME=chinverse-assets
# OBJECT_STORAGE_ACCESS_KEY_ID=set-in-secret-manager
# OBJECT_STORAGE_SECRET_ACCESS_KEY=set-in-secret-manager
# OBJECT_STORAGE_PUBLIC_BASE_URL=https://s3.hf.co/MoAmin9/chinverse-assets
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ADDRESSING_STYLE=path
