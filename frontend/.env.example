# Local development
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEPLOYMENT_TIER=staging
NEXT_PUBLIC_FEATURE_SUBSCRIPTIONS=false
NEXT_PUBLIC_FEATURE_REFERRALS=false
NEXT_PUBLIC_FEATURE_POINTS=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional public image CDN and extra public image origins (comma-separated).
# Private/authenticated media must not use these origins or Next image caching.
NEXT_PUBLIC_IMAGE_CDN_URL=
NEXT_PUBLIC_IMAGE_REMOTE_ORIGINS=

# BFF response-header deadline in milliseconds (1000..60000).
BACKEND_PROXY_TIMEOUT_MS=12000
# Multipart upload response deadline (10000..300000). Upload bodies are streamed.
BACKEND_PROXY_UPLOAD_TIMEOUT_MS=120000
# Browser API deadlines/retry policy (bounded by the client).
NEXT_PUBLIC_API_TIMEOUT_MS=15000
NEXT_PUBLIC_API_UPLOAD_TIMEOUT_MS=120000
NEXT_PUBLIC_API_RETRY_COUNT=1

# Error tracking is fail-closed: both switches and their matching DSNs are
# required. Keep disabled until telemetry consent and Sentry projects exist.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
# Set to the immutable deployed Git SHA so browser events correlate with builds.
NEXT_PUBLIC_RELEASE_SHA=
SENTRY_ENABLED=false
SENTRY_DSN=
# Optional source-map upload; store credentials only in Vercel secrets.
SENTRY_SOURCE_MAPS_ENABLED=false
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Production example
# NEXT_PUBLIC_API_URL=https://your-api-domain.com/api/v1
# NEXT_PUBLIC_DEPLOYMENT_TIER=production
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=set-in-vercel-environment
